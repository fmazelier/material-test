server {
  listen 80;
  server_name _;

  # ─── Compression ───────────────────────────────────────────────────
  # Enable gzip for text-based assets; skip small files under 1KB
  # gzip_vary tells proxies/CDNs to cache both compressed and uncompressed versions
  gzip on;
  gzip_vary on;
  gzip_types text/plain text/css application/javascript application/json
             image/svg+xml application/wasm;
  gzip_min_length 1024;

  # ─── Security headers ──────────────────────────────────────────────
  # Applied globally to all responses

  # Prevents the page from being embedded in an iframe on other domains
  # Protects against clickjacking attacks
  add_header X-Frame-Options "SAMEORIGIN" always;

  # Prevents browsers from MIME-sniffing the content-type
  # Stops browsers from interpreting files as a different type than declared
  # e.g. prevents a .txt file from being executed as JavaScript
  add_header X-Content-Type-Options "nosniff" always;

  # Controls how much referrer info is sent with requests
  # strict-origin-when-cross-origin: sends full URL within same origin,
  # only the domain on cross-origin HTTPS→HTTPS, nothing on HTTPS→HTTP
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # Prevents the browser from loading any resource (scripts, styles, images, API calls...)
  # from origins not explicitly listed — the strongest XSS mitigation available
  # unsafe-inline is required for Angular Material inline styles; remove if using nonces
  # add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self'; connect-src 'self';" always;
  add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self'; connect-src 'self';" always;

  # ─── index.html — never cache ──────────────────────────────────────
  # SPA entry point must always be fresh so the browser loads
  # the latest JS/CSS filenames generated by Angular's build
  location = ${BASE_HREF}index.html {
    alias /usr/share/nginx/html/app/index.html;
    add_header Cache-Control "no-cache, no-store, must-revalidate";
  }

  # ─── Runtime config ────────────────────────────────────────────────
  # Never cache config.json — contains runtime values (apiUrl, deployedAt...)
  # injected at container startup and must always be fresh
  location = ${BASE_HREF}config.json {
    alias /usr/share/nginx/html/app/config.json;
    add_header Cache-Control "no-cache, no-store, must-revalidate";
  }

  # ─── Lottie animations ─────────────────────────────────────────────
  # Not fingerprinted by Angular — cache for 30 days
  # stale-while-revalidate allows serving stale content while revalidating in background
  location ${BASE_HREF}lottie-animations/ {
    alias /usr/share/nginx/html/app/lottie-animations/;
    add_header Cache-Control "public, max-age=2592000, stale-while-revalidate=86400";
    access_log off;
  }

  # ─── Health check ──────────────────────────────────────────────────
  # Dedicated endpoint for k8s liveness/readiness probes
  # Returns 200 without hitting app logic or generating access logs
  location = /healthz {
    access_log off;
    return 200 "ok";
    add_header Content-Type text/plain;
  }

  # ─── Angular SPA ───────────────────────────────────────────────────
  # Serves the app under its base href; falls back to index.html for client-side routing
  location ${BASE_HREF} {
    alias /usr/share/nginx/html/app/;
    try_files $uri $uri/ ${BASE_HREF}index.html;

    # Fingerprinted assets (Angular build: JS, CSS, fonts in /media)
    # Safe to cache forever — filename changes on every build
    location ~* ^.+\.(js|css)$|^.+/media/.+$ {
      add_header Cache-Control "public, max-age=31536000, immutable";
      access_log off;
    }

    # Static public assets (images, icons, fonts from /public folder)
    # Cached for 1 day — ETag allows browser to revalidate without re-downloading
    location ~* \.(ico|png|svg|webp|jpg|jpeg|gif|woff2|ttf)$ {
      add_header Cache-Control "public, max-age=86400, must-revalidate";
      access_log off;
    }
  }

  # ─── Root redirect ─────────────────────────────────────────────────
  # Redirect bare root to the app base href
  location = / {
    return 301 ${BASE_HREF};
  }

  # ─── Security ──────────────────────────────────────────────────────
  # Block access to hidden files
  location ~ /\. {
    deny all;
  }
}
